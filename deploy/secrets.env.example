# Copy to deploy/secrets.env and fill values, then:
# set -a ; source deploy/secrets.env ; set +a
# ./deploy/setup-github-secrets.sh davidfronek/tankovani

SSH_HOST=your.server.ip.or.domain
SSH_USER=deploy
# Multi-line private key content (do not quote with single-line)
SSH_PRIVATE_KEY=
DEPLOY_PATH=/opt/tankovani

# Optional
SSH_PORT=22
DEPLOY_MODE=node
SERVICE_NAME=tankovani
WEB_ROOT=/var/www/tankovani
